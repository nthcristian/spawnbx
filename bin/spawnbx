#!/usr/bin/env bash

set -euo pipefail

# Default values
DEFAULT_IMAGE="dev-arch"
DEFAULT_SHELL="/bin/bash"
IMAGE="$DEFAULT_IMAGE"
SHELL_CMD="$DEFAULT_SHELL"
NAME="$(basename "$PWD")"

# ------------------------------------------------------------------
# Help / usage
# ------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  -i, --image IMAGE   Container image to use (default: $DEFAULT_IMAGE)
  -s, --shell SHELL   Shell to set as the default SHELL environment variable
                      (default: $DEFAULT_SHELL)
  -h, --help          Show this help message

If the container already exists, it will be started/attached using the
current options (they must match what was used to create it).
EOF
    exit 0
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--image)
            IMAGE="$2"
            shift 2
            ;;
        -s|--shell)
            SHELL_CMD="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            ;;
    esac
done

# ------------------------------------------------------------------
# GPU detection and flags (as arrays)
# ------------------------------------------------------------------
GPU_FLAGS=()
if command -v nvidia-smi &>/dev/null; then
    # NVIDIA GPU – requires nvidia-container-toolkit to be installed
    GPU_FLAGS=(
        --security-opt label=disable
        --device nvidia.com/gpu=all
        --env NVIDIA_VISIBLE_DEVICES=all
        --env NVIDIA_DRIVER_CAPABILITIES=all
    )
else
    # Intel / AMD GPU – pass DRI and keep group memberships
    GPU_FLAGS=(
        --device /dev/dri:/dev/dri
        --group-add keep-groups
    )
fi

# ------------------------------------------------------------------
# Audio flags (PipeWire, PulseAudio, ALSA)
# ------------------------------------------------------------------
AUDIO_FLAGS=()
if [[ -n "$XDG_RUNTIME_DIR" ]]; then
    # PipeWire socket
    if [[ -S "$XDG_RUNTIME_DIR/pipewire-0" ]]; then
        AUDIO_FLAGS+=(
            --volume "$XDG_RUNTIME_DIR/pipewire-0:/tmp/pipewire-0:Z"
        )
    fi
    # PulseAudio socket (provided by pipewire-pulse)
    if [[ -S "$XDG_RUNTIME_DIR/pulse/native" ]]; then
        AUDIO_FLAGS+=(
            --volume "$XDG_RUNTIME_DIR/pulse/native:/tmp/pulse-socket:Z"
            --env PULSE_SERVER=unix:/tmp/pulse-socket
        )
    fi
    # Let PipeWire use /tmp as XDG_RUNTIME_DIR inside the container
    AUDIO_FLAGS+=( --env XDG_RUNTIME_DIR=/tmp )
fi
# ALSA: pass sound devices directly
if [[ -e /dev/snd ]]; then
    AUDIO_FLAGS+=( --device /dev/snd )
fi

# ------------------------------------------------------------------
# GUI flags (Wayland preferred, fallback to X11)
# ------------------------------------------------------------------
GUI_FLAGS=()
if [[ -n "$WAYLAND_DISPLAY" ]]; then
    GUI_FLAGS=(
        --env WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
        --env XDG_RUNTIME_DIR=/tmp
        --volume "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/$WAYLAND_DISPLAY:Z"
        --env GDK_BACKEND=wayland
        --env QT_QPA_PLATFORM=wayland
        --env XDG_SESSION_TYPE=wayland
    )
elif [[ -n "$DISPLAY" ]]; then
    # X11 fallback – open access to local X server and revert on exit
    xhost +local: >/dev/null 2>&1
    trap 'xhost -local: >/dev/null 2>&1' EXIT

    GUI_FLAGS=(
        --env DISPLAY="$DISPLAY"
        --volume /tmp/.X11-unix:/tmp/.X11-unix:Z
        # --net=host is NOT needed for X11 and is deliberately omitted
    )
fi

# ------------------------------------------------------------------
# Function to handle existing container states
# ------------------------------------------------------------------
handle_existing() {
    local status
    status="$(podman container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo "missing")"

    case "$status" in
        running)
            echo "Attaching to running container '$NAME'..."
            # Attach to the container's main process
            exec podman attach "$NAME"
            ;;
        paused)
            echo "Unpausing container '$NAME'..."
            podman unpause "$NAME"
            echo "Attaching to container..."
            # Attach to the container's main process after unpausing
            exec podman attach "$NAME"
            ;;
        exited|stopped)
            echo "Starting stopped container '$NAME'..."
            # Start and attach to the main process
            exec podman start -ai "$NAME"
            ;;
        missing)
            return 1   # container does not exist, create new one
            ;;
        *)
            echo "Unknown container state: $status" >&2
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------
# Create new container (if it doesn't exist)
# ------------------------------------------------------------------
create_new() {
    echo "Creating new container '$NAME' from image '$IMAGE'..."
    exec podman run -it \
        --name "$NAME" \
        --hostname "$NAME" \
        --volume dev-home:/home/dev \
        --env HOME=/home/dev \
        --volume "$PWD":/workspace \
        --workdir /workspace \
        --userns=keep-id \
        --env SHELL="$SHELL_CMD" \
        -p 2222:22 \
        "${GUI_FLAGS[@]}" \
        "${GPU_FLAGS[@]}" \
        "${AUDIO_FLAGS[@]}" \
        "$IMAGE"
}

# ------------------------------------------------------------------
# Main logic
# ------------------------------------------------------------------
if podman container exists "$NAME" 2>/dev/null; then
    handle_existing
else
    create_new
fi
